# T-Deck: ESP32-S3-WROOM-1 N16R8 —— 16MB quad flash + 8MB octal PSRAM
# 实测值见 docs/hardware.md

CONFIG_IDF_TARGET="esp32s3"

# ── Flash ──
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ── 分区表:自定义,不做 OTA(ADR-005)──
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── PSRAM:N16R8 是八线 ──
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# LVGL 的帧缓冲和小智常驻的音频缓冲都吃 PSRAM,阈值放低让大块自动走 PSRAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# ── USB:固件跑起来后走 TinyUSB CDC,串口会重新枚举成带 MAC 的名字 ──
# (今天刷 Meshtastic 时观察到的现象,同一个机制)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── FreeRTOS:1000Hz tick,LVGL 动画才跟手 ──
CONFIG_FREERTOS_HZ=1000

# ── 崩溃现场存进 coredump 分区,bring-up 期间排错用 ──
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# ── C++ ──
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# ── LVGL ──
# 字体:bring-up 阶段够用。中文要另配 CJK 字体子集(放 storage 分区),后面再说。
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# LVGL 自带的 examples/demos 不编进固件 —— 白占 app 分区
# 径向渐变(动态背景的柔光色块要用),默认是关的
CONFIG_LV_USE_DRAW_SW_COMPLEX_GRADIENTS=y

# 截图接口要用(默认关)
CONFIG_LV_USE_SNAPSHOT=y

# LVGL 的分配器换成 C 标准库 malloc,而不是它自带的 64KB 静态池。
# 两个理由:
#   1. 一张 320x240 截图就要 150KB,自带池根本放不下
#   2. 小智集成后光 LVGL 图像缓存就要 2MB
# 系统 malloc 在 CONFIG_SPIRAM_USE_MALLOC 下能落到 8MB PSRAM,天花板消失。
CONFIG_LV_USE_BUILTIN_MALLOC=n
CONFIG_LV_USE_CLIB_MALLOC=y

CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_USE_DEMO_BENCHMARK=n
CONFIG_LV_USE_DEMO_STRESS=n
CONFIG_LV_USE_DEMO_MUSIC=n
CONFIG_LV_USE_DEMO_KEYPAD_AND_ENCODER=n
