# T-Deck: ESP32-S3-WROOM-1 N16R8 —— 16MB quad flash + 8MB octal PSRAM
# 实测值见 docs/hardware.md

CONFIG_IDF_TARGET="esp32s3"

# ── Flash ──
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ── 分区表:自定义,双槽 OTA ──
# 推固件走 WiFi(tools/ota.sh),不用再拔插 USB。详见 partitions.csv 抬头。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# 回滚:新固件先以 PENDING_VERIFY 启动,必须自己声明"我起来了"才作数。
# 声明点在 debug_server 启动处 —— 判据是"WiFi 通了、还能再推一版"。
# 推了个起不来的固件,板子自己退回上一版,不用拔线救砖。
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ── PSRAM:N16R8 是八线 ──
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# LVGL 的帧缓冲和小智常驻的音频缓冲都吃 PSRAM,阈值放低让大块自动走 PSRAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# ── USB:固件跑起来后走 TinyUSB CDC,串口会重新枚举成带 MAC 的名字 ──
# (今天刷 Meshtastic 时观察到的现象,同一个机制)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── FreeRTOS:1000Hz tick,LVGL 动画才跟手 ──
CONFIG_FREERTOS_HZ=1000

# ── 崩溃现场存进 coredump 分区,bring-up 期间排错用 ──
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# ── C++ ──
CONFIG_COMPILER_CXX_EXCEPTIONS=y
# 小智的 audio_service 用 dynamic_cast 区分 codec 子类,必须开 RTTI
CONFIG_COMPILER_CXX_RTTI=y

# ── LVGL ──
# 字体:bring-up 阶段够用。中文要另配 CJK 字体子集(放 storage 分区),后面再说。
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# LVGL 自带的 examples/demos 不编进固件 —— 白占 app 分区
# 径向渐变(动态背景的柔光色块要用),默认是关的
CONFIG_LV_USE_DRAW_SW_COMPLEX_GRADIENTS=y

# 截图接口要用(默认关)
CONFIG_LV_USE_SNAPSHOT=y

# 专辑封面是 JPEG。服务端能按尺寸裁好再发(/cover?w=&h=),
# 所以设备侧只要能解基线 JPEG 就够,不用 libjpeg-turbo 那种大家伙。
CONFIG_LV_USE_TJPGD=y




# LVGL 的分配器换成 C 标准库 malloc,而不是它自带的 64KB 静态池。
# 两个理由:
#   1. 一张 320x240 截图就要 150KB,自带池根本放不下
#   2. 小智集成后光 LVGL 图像缓存就要 2MB
# 系统 malloc 在 CONFIG_SPIRAM_USE_MALLOC 下能落到 8MB PSRAM,天花板消失。
CONFIG_LV_USE_BUILTIN_MALLOC=n
CONFIG_LV_USE_CLIB_MALLOC=y

CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_USE_DEMO_BENCHMARK=n
CONFIG_LV_USE_DEMO_STRESS=n
CONFIG_LV_USE_DEMO_MUSIC=n
CONFIG_LV_USE_DEMO_KEYPAD_AND_ENCODER=n

# LVGL 的 TJPGD 解码器要解【内存里】的 JPEG(我们的专辑封面是 HTTP 拉下来的,
# 不落盘),必须开 MEMFS —— 它把内存缓冲包装成 lv_fs 路径喂给解码器。
# 不开的话 lv_image_set_src 不报错,只是画不出来,是个静默失败。
# LETTER 默认 0 表示禁用,必须给个真盘符;'M' = 77,和现有的盘符都不冲突。
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77

# ⚠️ 中文字库【必须】开这个,否则一个字都画不出来(而且不报错)。
#
# LV_FONT_FMT_TXT_LARGE=0 时,lv_font_fmt_txt_glyph_dsc_t 是紧凑版:
#   uint32_t bitmap_index : 20;   ← 位图区最大只能 1MB
#   uint32_t adv_w        : 12;
#   uint8_t  box_w, box_h; int8_t ofs_x, ofs_y;      → 8 字节
# 开了之后才是 bitmap_index/adv_w 各 32 位、box/ofs 各 16 位 → 12 字节。
#
# font_puhui_common_20_4.bin 的位图区有 1548620 字节,【超过 1MB】,
# 所以它只能按 LARGE 版生成。用紧凑版的结构体去读,字形描述整体错位:
# box_h 解出来是 0 或垃圾,于是每个字只画出最后一行像素 —— 屏幕上是一条条
# 1px 横杠,或者干脆什么都没有。而 lv_font_get_glyph_dsc() 照样返回 true,
# 所以自检也发现不了。
#
# 判据很简单:位图区 = glyph_dsc 偏移 − glyph_bitmap 偏移,超过 1MB 就必须开。
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# 小智要跑 TLS,而内部 RAM 见底(小智起来后只剩 ~35KB)。
# mbedtls_ssl_setup 会返回 -0x7F00(ALLOC_FAILED)—— 这个错很容易被
# 当成证书问题去查,实际是内存。这两项把 TLS 的大块分配赶到 PSRAM 上。
# 取值对齐官方小智(otto-xiaozhi-esp32)那台能跑通的配置。
# ⚠️ 这个值是"多大以下的 malloc 一定放内部 RAM"。
# 2048 时 LVGL 的对象(一个 lv_obj_t 几百字节)全落在内部堆里 ——
# 封面墙一屏三十个格子、每格五个对象,光这一项就吃掉几十 KB,
# 实测内部堆被压到只剩 6.7KB,开个队列页就崩。
# 降到 256 之后这些对象走 PSRAM。需要 DMA 的地方都是用 heap_caps_malloc
# 显式要内部内存的,不受影响。
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# 列表里每行都有一张封面。LVGL 默认【不缓存】解码后的图,
# 缓存为 0 时每次重绘都要重新解一遍 JPEG —— 滚动列表会肉眼可见地卡。
# 512KB 够放下二十几张 46px 缩略图和播放页那张 120px 大图。
# 大于 2048 字节的分配会落到 PSRAM(见上面的 SPIRAM_MALLOC_ALWAYSINTERNAL),
# 所以这块缓存不吃内部 RAM。
# 封面已经在抓取时就解成 RGB565 存好了(见 music_app.cc 的 decode_thumb),
# 不再依赖 LVGL 的图片缓存,所以这里不用留那么大。
CONFIG_LV_CACHE_DEF_SIZE=65536
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=32

# 调性能时把这两行改成 y,屏幕左上角会显示 "FPS / CPU%" 和
# "总耗时 (渲染 | 刷屏)"。分清是渲染慢还是 SPI 慢全靠它 ——
# 这次就是靠它发现瓶颈在渲染(152ms 里 147ms 是渲染,刷屏只占 5ms),
# 而不是我一开始猜的 SPI 时钟。
# 注意 LV_USE_PERF_MONITOR 依赖 LV_USE_SYSMON,要一起开。
# CONFIG_LV_USE_SYSMON=y
# CONFIG_LV_USE_PERF_MONITOR=y

# ── Xtensa SIMD 渲染加速 ──────────────────────────────────
# esp_lvgl_port 为 ESP32-S3 手写了 blend 汇编,靠这三项挂进 LVGL。
# 只在 LVGL 9.1.x 上可用(见 main/idf_component.yml 的说明)。
CONFIG_LV_DRAW_SW_ASM_CUSTOM=y
CONFIG_LV_USE_DRAW_SW_ASM=255
CONFIG_LV_DRAW_SW_ASM_CUSTOM_INCLUDE="esp_lvgl_port_lv_blend.h"

# 双核渲染试过了,【更慢】:两个 draw unit 在抢内存带宽,同步开销盖过收益,
# 实测 41ms → 45ms,而且内部 RAM 从 100K 掉到 63K。保持单单元。
CONFIG_LV_OS_NONE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1

# LVGL 的刷新周期,默认 33ms —— 那是【30 FPS 的硬上限】,不是性能指标。
# 优化到 27ms/帧 之后量出来 28 FPS,其实是顶着这个上限,不是真实水平。
# 放到 16ms 才能看出实际能跑多少。这个值同时也是输入设备的轮询周期,
# 调小手感也更跟手。
CONFIG_LV_DEF_REFR_PERIOD=16
