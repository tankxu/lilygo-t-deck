// secrets.h.example — 复制成 secrets.h 后填自己的值
//
// secrets.h 在 .gitignore 里,不会进版本库。
#pragma once

#define WIFI_SSID      "your-ssid"
#define WIFI_PASSWORD  "your-password"

#define WX_LATITUDE    18.7883
#define WX_LONGITUDE   98.9853
#define WX_CITY        "Chiang Mai"
#define TZ_STRING      "ICT-7"     // 泰国 UTC+7

// 音乐服务(自建 xiaozhi-music-mcp)
#define MUSIC_BASE_URL "http://192.168.1.100:2234"
#define MUSIC_TOKEN    "your-mcp-token"

// B站转码服务(stackchan-bili 的 app/bili_srv.py),跑在同局域网的一台电脑上。
// 设备只跟这一个 IP 说话 —— 封面、列表、视频流都走它代理。
// 留空就进不了 bilibili app,会提示先配地址。
#define BILI_BASE_URL "http://192.168.1.2:2233"

// 学习卡片的素材服务(汉字卡/词卡 JPEG、笔顺 GIF)。
// 不填就用 learning.cc 里的默认值(R2 桶的自有域名,CDN 直出、无鉴权)。
// 自建服务时才需要改 —— 目录结构是 /card/<字或词>.jpg 和 /stroke/<字>.gif。
